
# Stage 1: Build the React application
FROM node:18-alpine as build
WORKDIR /app

# Copy root package.json and lock files
COPY package*.json ./

# Copy packages
COPY packages/shared ./packages/shared
# Need backend package.json just for workspaces validation usually, but maybe not if we explicitly install
COPY packages/back/package.json ./packages/back/package.json
COPY packages/front ./packages/front

# Install dependencies for the entire workspace
RUN npm install

# Build shared package first
WORKDIR /app/packages/shared
RUN npm run build || true

# Build frontend
WORKDIR /app/packages/front
ARG VITE_API_URL
ARG VITE_N8N_WEBHOOK_URL
ENV VITE_API_URL=$VITE_API_URL
ENV VITE_N8N_WEBHOOK_URL=$VITE_N8N_WEBHOOK_URL
RUN npm run build

# Stage 2: Serve the application with Nginx
FROM nginx:alpine
COPY --from=build /app/packages/front/dist /usr/share/nginx/html
# Note: nginx.conf is inside packages/front/nginx.conf, need to copy it from build context or from stage 1
COPY --from=build /app/packages/front/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
