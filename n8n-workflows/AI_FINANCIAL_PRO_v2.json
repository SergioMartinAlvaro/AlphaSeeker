        "jsCode": "\nfor (const item of items) {\n   const bucket = 'alphaseeker-assets';\n   let publicUrl = null;\n   \n   if (item.json.name && !item.json.error) {\n       const filename = item.json.name;\n       publicUrl = `https://storage.googleapis.com/${bucket}/${filename}`;\n   }\n   \n   item.json = {\n       ...item.json,\n       title: item.json.title || 'Market News',\n       content_summary: item.json.content_summary || '',\n       published_date: new Date().toISOString(),\n       url: item.json.url || '',\n       source: 'n8n',\n       investment_advice: item.json.investment_advice || {},\n       image_url: publicUrl\n   };\n}\nreturn items;\n"
      },
