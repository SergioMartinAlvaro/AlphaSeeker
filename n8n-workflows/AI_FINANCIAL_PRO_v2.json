    {
      "parameters": {
        "jsCode": "const newItems = $('Obtener contenido de noticias').all();\n\n// SAFETY FUNCTION to handle errors or empty inputs\nconst safeGet = (nodeName) => {\n  try {\n    const items = $(nodeName).all();\n    if (!items || items.length === 0) return [];\n    // If the first item contains an error key (from Continue on Fail), treat as empty\n    if (items[0].json && items[0].json.error) return [];\n    return items;\n  } catch (e) {\n    return [];\n  }\n};\n\nconst existingNews = safeGet('Get Existing News');\nconst cachedNews = safeGet('Get Cache');\n\nconst existingUrls = new Set(existingNews.map(i => i.json.url).filter(u => u));\nconst cachedMap = new Map();\ncachedNews.forEach(i => {\n  if(i.json.url) cachedMap.set(i.json.url, i.json);\n});\n\nconst toProcess = [];\n\nfor (const item of newItems) {\n  const url = item.json.link || item.json.url;\n  \n  // 1. Skip if already in Final DB (Deduplication)\n  if (existingUrls.has(url)) {\n      continue;\n  }\n\n  // 2. Check if in Cache\n  if (cachedMap.has(url)) {\n      // REPLAY CACHED RESULT\n      const cached = cachedMap.get(url);\n      item.json = {\n          ...item.json,\n          ...JSON.parse(cached.result_json || '{}'),\n          is_cached: true\n      };\n  } else {\n      // NEW ITEM\n      item.json.is_cached = false;\n      // Prepare Prompt here\n      const raw_text = item.json.content || item.json.description || item.json.summary || \"\";\n      const fullPrompt = `### System Prompt:\\nEres un analista financiero experto de Wall Street... \\n\\n### Noticia:\\n${raw_text}\\n### JSON Esperado:`;\n      item.json.prompt_para_api = fullPrompt;\n  }\n  toProcess.push(item);\n}\n\nreturn toProcess;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
