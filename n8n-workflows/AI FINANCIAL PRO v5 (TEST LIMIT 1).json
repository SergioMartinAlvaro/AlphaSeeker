    {
      "parameters": {
        "jsCode": "\nfor (const item of items) {\n  let llmResult = {};\n  \n  // FIX: Handle 'result_json' string from Cache or Previous Node\n  if (item.json.result_json) {\n      try {\n          const parsed = typeof item.json.result_json === 'string' ? JSON.parse(item.json.result_json) : item.json.result_json;\n          // Unwrap nested 'body.results'\n          if (parsed['body.results']) {\n              llmResult = parsed['body.results'];\n          } else if (parsed.body && parsed.body.results) {\n              llmResult = parsed.body.results;\n          } else {\n              llmResult = parsed;\n          }\n      } catch (e) {\n          console.log('Error parsing result_json', e);\n      }\n  } else if (item.json.result) {\n      // Fallback for legacy format\n       llmResult = typeof item.json.result === 'string' ? JSON.parse(item.json.result) : item.json.result;\n  }\n\n  const subjectPrompt = item.json.image_prompt || (llmResult ? llmResult.image_prompt : '') || 'Financial graph';\n  \n  // Use existing image_url from microservice if available\n  let imageUrl = llmResult.image_url || item.json.image_url || item.json.generated_image_url || '';\n  let tempId = item.json.temp_id || 'news_' + Math.floor(Math.random()*100000);\n\n  if (!imageUrl || !imageUrl.includes('storage.googleapis.com')) {\n      // Fallback if no valid image\n      imageUrl = 'https://placehold.co/800x600/1e3a8a/ffffff.png?text=AlphaSeeker+Market+Analysis';\n  }\n  \n  item.json = {\n    ...item.json,\n    ...llmResult,\n    generated_image_url: imageUrl,\n    temp_id: tempId\n  };\n}\nreturn items;\n"
      },
