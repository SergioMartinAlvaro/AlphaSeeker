      "parameters": {
        "jsCode": "\nconst validItems = [];\nconst seenIds = new Set();\n\nfor (const item of items) {\n   let data = item.json;\n\n   // Same robust parsing logic as Deduplicator\n   if (data['body.results']) {\n       if (data['body.results'].result_json) {\n           // ... existing logic ...\n       }\n   }\n   // Note: Simplified for brevity in this task, reusing existing logic structure\n\n   const bucket = 'alphaseeker-assets';\n   let imageUrl = data.image_url || item.json.generated_image_url || '';\n   \n   // Final check\n   if (!imageUrl) imageUrl = 'https://placehold.co/800x600/1e3a8a/ffffff.png?text=AlphaSeeker';\n\n   if (data.action === 'DISCARD' || data.market_impact === 'IRRELEVANT') {\n       continue;\n   }\n\n   const generatedId = data.url ? data.url.replace(/[^a-zA-Z0-9]/g, '_').substring(0, 100) : 'news_' + Math.floor(Math.random() * 1000);\n\n   if (seenIds.has(generatedId)) {\n       console.log('Saltando ID repetido');\n       continue;\n   }\n   seenIds.add(generatedId);\n\n   const normalized = {\n       id: generatedId,\n       title: data.title || 'Market News',\n       content_summary: data.summary || data.content_summary || '',\n       content: data.source_content || data.content || '', \n       published_date: new Date().toISOString(),\n       url: data.url || '',\n       source: 'n8n',\n       investment_advice: data.investment_advice || { rating: 'Hold', reasoning: 'Insufficient data' },\n       market_impact: data.market_impact || '',\n       risk_level: data.risk_level || 'MEDIUM',\n       sentiment: data.sentiment || 'NEUTRAL',\n       analysis: data.analysis || data.market_impact || '', \n       action: data.action || 'HOLD',\n       category: data.category || 'MERCADOS',\n       asset_class: data.asset_class || 'ACCIONES',\n       tags: Array.isArray(data.tags) ? data.tags : [],\n       social_content: data.social_content || data.content_summary || '',\n       image_url: imageUrl\n   };\n\n   if (!normalized.market_impact) {\n       continue;\n   }\n\n   item.json = normalized;\n   validItems.push(item);\n}\n\nreturn validItems;\n"
      },
