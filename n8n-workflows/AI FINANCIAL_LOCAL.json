    {
      "parameters": {
        "jsCode": "\nconst validItems = [];\n\nfor (const item of items) {\n   // 1. Get Image URL from the previous node's output\n   const imageUrl = item.json.generated_image_url || '';\n   \n   // 2. DATA SOURCE: The input item.json\n   const data = item.json;\n\n   // 3. DISCARD FILTER (Logic Kill Switch)\n   if (data.action === 'DISCARD' || data.market_impact === 'IRRELEVANT') {\n       console.log('Skipping IRRELEVANT item:', data.title);\n       continue;\n   }\n\n   // 4. MAP & NORMALIZE\n   const normalized = {\n       title: data.title || 'Market News',\n       content_summary: data.summary || data.content_summary || '',\n       content: data.source_content || data.content || '', \n       published_date: data.published_date || new Date().toISOString(),\n       url: data.url || '',\n       source: 'n8n',\n       investment_advice: data.investment_advice || { rating: 'Hold', reasoning: 'Insufficient data' },\n       market_impact: data.market_impact || '',\n       risk_level: data.risk_level || 'MEDIUM',\n       sentiment: data.sentiment || 'NEUTRAL',\n       analysis: data.analysis || '',\n       action: data.action || 'HOLD',\n       image_url: imageUrl\n   };\n\n   // 5. VALIDATION\n   if (!normalized.market_impact) {\n       console.log('Skipping due to missing market_impact');\n       continue;\n   }\n\n   item.json = normalized;\n   validItems.push(item);\n}\n\nreturn validItems;\n"
      },
