    {
      "parameters": {
        "jsCode": "// Prepare Batch Image Request\nconst itemsToSend = items.map(item => {\n    // Ensure we send a valid JSON object\n    const data = item.json;\n    \n    // Parse result_json if it comes from cache logic output\n    // (Usually 'Save to Cache' output might change structure depending on node version, but assume it passes through item.json)\n    \n    // Fallback prompt generation\n    let prompt = data.image_prompt || data.title || \"Financial news\";\n    \n    return {\n        ...data,\n        image_prompt: prompt\n    };\n});\n\nreturn [{\n    json: {\n        items: itemsToSend,\n        callback_url: \"http://n8n:5678/webhook/webhook-image-callback\"\n    }\n}];"
      },
